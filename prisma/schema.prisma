generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CONDUCTOR
  AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum CardStatus {
  ACTIVE
  FROZEN
  REPLACED
  LOST
  DAMAGED
}

enum MerchantCategory {
  TRANSPORT
  RETAIL
  FERRY
  STADIUM
  EVENT
  PARKING
  OTHER
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
}

enum TerminalType {
  NFC_READER
  POS
  GATE
  APP
}

enum TerminalStatus {
  ACTIVE
  INACTIVE
}

enum ServiceType {
  TRANSPORT
  RETAIL
  FERRY
  STADIUM
  EVENT
  PARKING
  OTHER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TopUpSource {
  AGENT_TOPUP
  INITIAL_LOAD
  ADMIN_ADJUST
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum SettlementStatus {
  DRAFT
  FINALIZED
  PAID
}

enum CardInventoryStatus {
  IN_STOCK
  ISSUED
  DAMAGED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKED
}

enum RefundStatus {
  COMPLETED
}

model User {
  id                  String     @id @default(uuid())
  username            String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String     @unique
  nida                String     @unique
  email               String?
  tillNumber          String?
  role                UserRole
  status              UserStatus @default(ACTIVE)
  sessionVersion      Int        @default(0)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  merchants           Merchant[]
  terminals           Terminal[]
  auditLogs           AuditLog[]
  topUps              TopUp[]              @relation("TopUpAgent")
  withdrawals         Withdrawal[]         @relation("WithdrawalAgent")
  withdrawalsProcessed Withdrawal[]        @relation("WithdrawalProcessor")
  conductorWithdrawals Withdrawal[]        @relation("WithdrawalConductor")
  settlementsPaid     Settlement[]         @relation("SettlementPayer")
  refunds             Refund[]
}

model Customer {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  phone     String     @unique
  nida      String     @unique
  email     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  wallet    Wallet?
}

model Wallet {
  id           String                @id @default(uuid())
  publicCode   String                @unique
  customerId   String                @unique
  customer     Customer              @relation(fields: [customerId], references: [id])
  balance      Int                   @default(0)
  status       WalletStatus          @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  cards        Card[]
  transactions PaymentTransaction[]
  topUps       TopUp[]
}

model Card {
  id           String                @id @default(uuid())
  serialNumber String                @unique
  nfcUid       String?               @unique
  status       CardStatus            @default(ACTIVE)
  issuedAt     DateTime              @default(now())
  walletId     String
  wallet       Wallet                @relation(fields: [walletId], references: [id])
  replacedById String?               @unique
  replacedBy   Card?                 @relation("CardReplacement", fields: [replacedById], references: [id])
  replaces     Card?                 @relation("CardReplacement")
  transactions PaymentTransaction[]
  topUps       TopUp[]
}

model Merchant {
  id                String                @id @default(uuid())
  merchantCode      String                @unique
  name              String
  category          MerchantCategory
  settlementAccount String?
  ownerUserId       String?
  owner             User?                 @relation(fields: [ownerUserId], references: [id])
  status            MerchantStatus        @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  terminals         Terminal[]
  transactions      PaymentTransaction[]
  settlementLines   SettlementLine[]
}

model Terminal {
  id           String                @id @default(uuid())
  terminalCode String                @unique
  merchantId   String
  merchant     Merchant              @relation(fields: [merchantId], references: [id])
  ownerUserId  String?
  owner        User?                 @relation(fields: [ownerUserId], references: [id])
  type         TerminalType
  status       TerminalStatus        @default(ACTIVE)
  transactions PaymentTransaction[]

  @@index([ownerUserId])
}

model PaymentTransaction {
  id          String            @id @default(uuid())
  reference   String            @unique
  cardId      String
  card        Card              @relation(fields: [cardId], references: [id])
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id])
  merchantId  String
  merchant    Merchant          @relation(fields: [merchantId], references: [id])
  terminalId  String?
  terminal    Terminal?         @relation(fields: [terminalId], references: [id])
  amount      Int
  currency    String            @default("TZS")
  serviceType ServiceType
  status      TransactionStatus
  createdAt   DateTime          @default(now())
  refund      Refund?

  @@index([createdAt])
  @@index([walletId, createdAt])
}

model SmsOutbox {
  id                 String    @id @default(uuid())
  phone              String
  message            String
  type               String
  status             String    @default("PENDING")
  provider           String?
  providerMessageId  String?
  providerStatus     String?
  attemptCount       Int       @default(0)
  nextAttemptAt      DateTime?
  deliveryPollCount  Int       @default(0)
  nextDeliveryPollAt DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@unique([provider, providerMessageId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}

model TopUp {
  id              String      @id @default(uuid())
  reference       String      @unique
  walletId        String
  wallet          Wallet      @relation(fields: [walletId], references: [id])
  cardId          String?
  card            Card?       @relation(fields: [cardId], references: [id])
  agentUserId     String?
  agent           User?       @relation("TopUpAgent", fields: [agentUserId], references: [id])
  amount          Int
  previousBalance Int
  newBalance      Int
  source          TopUpSource
  createdAt       DateTime    @default(now())

  @@index([createdAt])
  @@index([walletId])
  @@index([agentUserId])
}

model Withdrawal {
  id              String           @id @default(uuid())
  reference       String           @unique
  agentUserId     String
  agent           User             @relation("WithdrawalAgent", fields: [agentUserId], references: [id])
  /** Conductor cash-out via wakala till (null for agent→platform withdrawals). */
  conductorUserId String?
  conductor       User?            @relation("WithdrawalConductor", fields: [conductorUserId], references: [id])
  amount          Int
  status          WithdrawalStatus @default(PENDING)
  notes           String?
  requestedAt     DateTime         @default(now())
  processedById   String?
  processedBy     User?            @relation("WithdrawalProcessor", fields: [processedById], references: [id])
  processedAt     DateTime?

  @@index([status, requestedAt])
  @@index([agentUserId])
  @@index([conductorUserId, requestedAt])
}

model Settlement {
  id            String           @id @default(uuid())
  reference     String           @unique
  periodStart   DateTime
  periodEnd     DateTime
  status        SettlementStatus @default(DRAFT)
  grossAmount   Int              @default(0)
  feeAmount     Int              @default(0)
  netAmount     Int              @default(0)
  createdAt     DateTime         @default(now())
  finalizedAt   DateTime?
  paidAt        DateTime?
  paidById      String?
  paidBy        User?            @relation("SettlementPayer", fields: [paidById], references: [id])
  lines         SettlementLine[]

  @@index([createdAt])
  @@index([status])
}

model SettlementLine {
  id                String     @id @default(uuid())
  settlementId      String
  settlement        Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  merchantId        String
  merchant          Merchant   @relation(fields: [merchantId], references: [id])
  grossAmount       Int
  feeAmount         Int
  netAmount         Int
  settlementAccount String?

  @@index([settlementId])
  @@index([merchantId])
}

model CardInventory {
  id           String              @id @default(uuid())
  serialNumber String              @unique
  nfcUid       String?             @unique
  status       CardInventoryStatus @default(IN_STOCK)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
}

model Refund {
  id            String            @id @default(uuid())
  reference     String            @unique
  transactionId String            @unique
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id])
  amount        Int
  reason        String?
  actorUserId   String
  actor         User              @relation(fields: [actorUserId], references: [id])
  status        RefundStatus      @default(COMPLETED)
  createdAt     DateTime          @default(now())

  @@index([createdAt])
}

model Alert {
  id         String        @id @default(uuid())
  type       String
  severity   AlertSeverity @default(INFO)
  message    String
  entityType String?
  entityId   String?
  status     AlertStatus   @default(OPEN)
  createdAt  DateTime      @default(now())
  ackedAt    DateTime?

  @@index([status, createdAt])
  @@index([type])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
