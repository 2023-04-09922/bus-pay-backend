# Local PostgreSQL 18
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/buspay?schema=public"
PORT=3000
JWT_SECRET=change-me

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Beem SMS (Tanzanian networks) ---
# Leave SMS_PROVIDER=mock (or omit Beem keys) for local MVP without sending real SMS.
# Switch to production later: SMS_PROVIDER=beem + real API key/secret + approved sender name.
SMS_PROVIDER=mock
SMS_DISPATCH_ENABLED=true
SMS_DISPATCH_INTERVAL_MS=10000

BEEM_SMS_API_KEY=
BEEM_SMS_SECRET_KEY=
BEEM_SMS_SENDER_NAME=INFO
# Production: https://apisms.beem.africa/v1
# Staging (if available on your Beem account): https://dev-sms.beem.africa/v1
BEEM_SMS_BASE_URL=https://apisms.beem.africa/v1
